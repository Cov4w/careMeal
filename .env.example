# CareMeal Environment Variables
# Copy this file to .env and fill in the values

# Database (PostgreSQL)
# For production:
DATABASE_URL=postgresql://caremeal_user:password@localhost:5432/caremeal
# For development (SQLite):
# DATABASE_URL=sqlite:///./caremeal.db

# PostgreSQL credentials (for docker-compose)
DB_USER=caremeal_user
DB_PASSWORD=your-secure-password

# API Keys (Required)
GEMINI_API_KEY=your-gemini-api-key
FAV_API_KEY=your-fav-api-key

# JWT Settings (Required for production)
JWT_SECRET_KEY=your-very-long-random-secret-key-here

# CORS Settings (Comma-separated list of allowed origins)
# For development:
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost:3000
# For production:
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
